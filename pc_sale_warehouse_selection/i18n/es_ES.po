#. module: pc_sale_warehouse_selection
#: model:ir.model,name:pc_sale_warehouse_selection.model_sale_order
msgid "Sales Order"
msgstr "Pedido de venta"

#. module: pc_sale_warehouse_selection
#: model:ir.model,name:pc_sale_warehouse_selection.model_stock_warehouse
msgid "Warehouse"
msgstr "Almacén"

#. module: pc_sale_warehouse_selection
#: model:ir.model.fields,field_description:pc_sale_warehouse_selection.field_stock_warehouse__is_virtual_warehouse
msgid "Virtual Aggregator Warehouse"
msgstr "Almacén virtual agregador"

#. module: pc_sale_warehouse_selection
#: model:ir.model.fields,help:pc_sale_warehouse_selection.field_stock_warehouse__is_virtual_warehouse
msgid ""
"When checked, sale orders confirmed against this warehouse will be "
"automatically reassigned to the physical child warehouse with the best "
"stock coverage."
msgstr ""
"Si está marcado, los pedidos de venta confirmados contra este almacén "
"se reasignarán automáticamente al almacén físico hijo que mejor cubra "
"la demanda."

#. module: pc_sale_warehouse_selection
#: model:ir.model.fields,field_description:pc_sale_warehouse_selection.field_stock_warehouse__pc_child_warehouse_ids
msgid "Physical Child Warehouses"
msgstr "Almacenes físicos hijos"

#. module: pc_sale_warehouse_selection
#: model:ir.model.fields,help:pc_sale_warehouse_selection.field_stock_warehouse__pc_child_warehouse_ids
msgid ""
"Physical warehouses whose stock is aggregated by this virtual warehouse "
"and that participate in the auto-selection and consolidation logic."
msgstr ""
"Almacenes físicos cuyo stock se agrega en este almacén virtual y que "
"participan en la lógica de selección automática y consolidación."

#. module: pc_sale_warehouse_selection

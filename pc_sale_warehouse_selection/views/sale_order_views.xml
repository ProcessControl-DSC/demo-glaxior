<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_pc_warehouse_selection" model="ir.ui.view">
        <field name="name">sale.order.form.pc.warehouse.selection</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="pc_warehouse_selection_mode" readonly="1"
                       invisible="not pc_warehouse_selection_mode"/>
                <field name="pc_original_warehouse_id" readonly="1"
                       invisible="not pc_original_warehouse_id"/>
                <field name="pc_requires_consolidation" readonly="1"
                       invisible="not pc_requires_consolidation"/>
            </xpath>
            <xpath expr="//button[@name='action_view_delivery']" position="after">
                <button name="action_view_pc_consolidation_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="pc_consolidation_picking_count == 0"
                        groups="stock.group_stock_user">
                    <field name="pc_consolidation_picking_count"
                           widget="statinfo"
                           string="Consolidation"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

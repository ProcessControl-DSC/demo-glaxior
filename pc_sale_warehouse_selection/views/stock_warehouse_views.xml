<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_form_virtual_aggregator" model="ir.ui.view">
        <field name="name">stock.warehouse.form.virtual.aggregator</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='resupply_wh_ids']" position="after">
                <field name="is_virtual_warehouse"/>
                <field name="pc_child_warehouse_ids"
                       widget="many2many_tags"
                       invisible="not is_virtual_warehouse"
                       required="is_virtual_warehouse"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_pc_negative_stock" model="ir.ui.view">
        <field name="name">pos.order.form.pc.negative.stock</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="pc_negative_stock_authoriser"
                      string="Negative Stock Authorisation"
                      invisible="not negative_stock_authorizer_id">
                    <group>
                        <field name="negative_stock_authorizer_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
